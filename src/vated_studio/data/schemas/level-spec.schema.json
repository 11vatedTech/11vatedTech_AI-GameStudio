{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Level Specification",
  "type": "object",
  "required": [
    "schema_version",
    "level_id",
    "player_goal",
    "layout_description",
    "critical_path",
    "fail_states",
    "readability_criteria"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "level_id": {
      "type": "string"
    },
    "player_goal": {
      "type": "string"
    },
    "layout_description": {
      "type": "string"
    },
    "critical_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "encounters": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Encounter",
        "type": "object",
        "required": [],
        "properties": {
          "id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "challenge": {
            "type": "string"
          },
          "reward": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    },
    "fail_states": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "navigation_cues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "accessibility_considerations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "collision_contract": {
      "type": "string"
    },
    "readability_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
