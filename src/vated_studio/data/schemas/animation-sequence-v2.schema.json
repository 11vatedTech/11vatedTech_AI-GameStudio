{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://11vatedtech.dev/schemas/animation-sequence-v2.schema.json",
  "title": "Agent-first animation sequence manifest",
  "type": "object",
  "required": [
    "schema_version",
    "sequence_id",
    "action_kind",
    "method",
    "frame_rate",
    "frame_count",
    "phases",
    "identity_invariants",
    "events",
    "review",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "sequence_id": {
      "type": "string",
      "minLength": 1
    },
    "action_kind": {
      "enum": [
        "idle",
        "walk",
        "run",
        "turn",
        "jump",
        "dodge",
        "hit_reaction",
        "attack",
        "heavy_attack",
        "combo",
        "spellcast",
        "interaction",
        "death",
        "other"
      ]
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "frame_rate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 120
    },
    "frame_count": {
      "type": "integer",
      "minimum": 2
    },
    "source_reference_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "name",
          "start_frame",
          "end_frame"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "end_frame": {
            "type": "integer",
            "minimum": 0
          },
          "purpose": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "identity_invariants": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "frame",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "frame": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "hitbox_on",
              "hitbox_off",
              "impact",
              "sound",
              "vfx",
              "combo_open",
              "combo_close",
              "cancel_open",
              "root_motion",
              "marker",
              "other"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "object",
      "required": [
        "source",
        "review_frame_strip"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "keyframe_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "frame_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_frame_strip": {
          "type": "string"
        },
        "playback_video": {
          "type": [
            "string",
            "null"
          ]
        },
        "engine_capture": {
          "type": [
            "string",
            "null"
          ]
        },
        "engine_log": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "required": [
        "status",
        "intended_speed_reviewed",
        "slow_reviewed",
        "identity_checked",
        "prop_contact_checked",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "candidate",
            "technical-valid",
            "identity-valid",
            "motion-valid",
            "integrated",
            "runtime-verified",
            "agent-approved",
            "operator-approved",
            "rights-cleared",
            "rejected"
          ]
        },
        "intended_speed_reviewed": {
          "type": "boolean"
        },
        "slow_reviewed": {
          "type": "boolean"
        },
        "identity_checked": {
          "type": "boolean"
        },
        "prop_contact_checked": {
          "type": "boolean"
        },
        "integrated": {
          "type": "boolean"
        },
        "runtime_observed": {
          "type": "boolean"
        },
        "operator_approval_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
