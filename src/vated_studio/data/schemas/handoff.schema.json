{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production Handoff",
  "type": "object",
  "required": [
    "schema_version",
    "handoff_id",
    "producer_role",
    "consumer_role",
    "inputs",
    "outputs",
    "acceptance_criteria",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "handoff_id": {
      "type": "string"
    },
    "producer_role": {
      "type": "string"
    },
    "consumer_role": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "known_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "accepted",
        "rejected",
        "blocked"
      ]
    },
    "accepted_by": {
      "type": "string"
    },
    "accepted_at": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
