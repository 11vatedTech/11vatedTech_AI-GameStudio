{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Workflow",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "title",
    "current_stage",
    "history"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "current_stage": {
      "enum": [
        "discover",
        "research",
        "define",
        "design",
        "scope",
        "prototype",
        "visual_identity",
        "vertical_slice",
        "produce",
        "integrate",
        "playtest",
        "refine",
        "verify",
        "package",
        "release",
        "learn"
      ]
    },
    "history": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Stage Event",
        "type": "object",
        "required": [
          "stage",
          "occurred_at",
          "evidence",
          "note"
        ],
        "properties": {
          "stage": {
            "type": "string"
          },
          "occurred_at": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
