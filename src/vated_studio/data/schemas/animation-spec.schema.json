{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Animation Specification",
  "type": "object",
  "required": [
    "schema_version",
    "animation_id",
    "character_id",
    "action",
    "intent",
    "key_pose_plan",
    "timing",
    "anchor_contract",
    "acceptance_criteria"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "animation_id": {
      "type": "string"
    },
    "character_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "action_category": {
      "enum": [
        "locomotion",
        "idle",
        "attack",
        "reaction",
        "interaction",
        "traversal",
        "death",
        "ability",
        "environment",
        "ui",
        "other"
      ]
    },
    "key_pose_plan": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Key Pose",
        "type": "object",
        "required": [
          "name",
          "purpose"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "time_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reference": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "timing": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Timing",
      "type": "object",
      "required": [
        "fps",
        "loop"
      ],
      "properties": {
        "fps": {
          "type": "number",
          "minimum": 1,
          "maximum": 120
        },
        "loop": {
          "type": "boolean"
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "anticipation_notes": {
          "type": "string"
        },
        "contact_frame": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "anchor_contract": {
      "type": "string"
    },
    "identity_invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "alpha_policy": {
      "type": "string"
    },
    "interpolation_policy": {
      "type": "string"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "review_required": {
      "type": "boolean",
      "default": true
    }
  },
  "additionalProperties": true
}
