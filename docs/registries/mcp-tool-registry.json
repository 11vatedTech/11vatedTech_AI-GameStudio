{
  "schema_version": "1.0",
  "last_reviewed": "2026-10-20",
  "policy": "free-local-first; opt-in installs; evidence-driven status",
  "tools": [
    {
      "id": "mcp-for-blender",
      "name": "MCP for Blender",
      "repository": "https://github.com/ahujasid/mcp-for-blender",
      "role": [
        "3d-modeling",
        "rigging",
        "animation",
        "render-review",
        "scene-inspection"
      ],
      "license_snapshot": "MIT source; separate privacy/terms must be reviewed",
      "priority": "P0",
      "status": "researched-not-installed-by-this-overlay",
      "free_local_path": true,
      "health_check": "MCP host lists Blender tools; addon socket responds only on localhost",
      "security": {
        "localhost_only": true,
        "safe_mode_required_initially": true,
        "telemetry_disabled": true,
        "backup_source_blend": true,
        "risk": "Socket has no auth/encryption; code execution can modify scene. Run against a copied project and review scripts."
      },
      "smoke_test": [
        "list scene objects/armatures/actions",
        "key one bone on a disposable rig",
        "render and inspect one action frame",
        "verify source .blend hash unchanged"
      ],
      "source": "https://github.com/ahujasid/mcp-for-blender"
    },
    {
      "id": "comfy-mcp",
      "name": "Comfy MCP",
      "repository": "https://github.com/Comfy-Org/comfy-mcp",
