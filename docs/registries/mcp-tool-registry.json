      "free_local_path": true,
      "health_check": "MCP tools list + live ComfyUI nodes/models/templates query",
      "security": {
        "local_endpoint_only": true,
        "custom_nodes_reviewed": true,
        "network_and_model_downloads_opt_in": true,
        "note": "Use locally installed ComfyUI; do not select cloud route by default."
      },
      "smoke_test": [
        "query live model/node inventory",
        "run a tiny known workflow",
        "collect output and hash",
        "cancel a disposable async test job"
      ],
      "source": "https://github.com/Comfy-Org/comfy-mcp"
    },
