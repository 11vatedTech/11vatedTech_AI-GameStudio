{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audio Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string"
    },
    "assets": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Audio Asset",
        "type": "object",
        "required": [
          "asset_id",
          "role",
          "path",
          "sha256",
          "license_status"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "music",
              "ambience",
              "sfx",
              "ui",
              "voice",
              "other"
            ]
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "license_status": {
            "enum": [
              "verified",
              "conditional",
              "unclear",
              "human_review_required",
              "prohibited"
            ]
          },
          "source": {
            "type": "string"
          },
          "sample_rate": {
            "type": "integer",
            "minimum": 1
          },
          "channels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "integration_events": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mix_notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
