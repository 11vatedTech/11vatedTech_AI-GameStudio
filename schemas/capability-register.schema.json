{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability Register",
  "type": "object",
  "required": [
    "schema_version",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Capability",
        "type": "object",
        "required": [
          "id",
          "label",
          "status",
          "interface",
          "purpose",
          "evidence_level"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "interface": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_level": {
            "enum": [
              "documented",
              "implemented",
              "tested-with-mocks",
              "tested",
              "demonstrated",
              "human-approved",
              "blocked"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
