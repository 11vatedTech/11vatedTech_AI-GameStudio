; Torch: Dominions — matched interactive camera benchmark (diagnostic blockout, not game production)
config_version=5

[application]
config/name="Torch Dominions — Interactive Camera Benchmark"
run/main_scene="res://benchmark.tscn"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.05, 0.065, 1)
