; Torch: Dominions — camera comparison proof, source concepts only.
config_version=5

[application]
config/name="Torch Dominions — Camera Comparison Proof"
run/main_scene="res://comparison.tscn"

[display]
window/size/viewport_width=1360
window/size/viewport_height=800
window/size/window_width_override=1360
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.05, 0.065, 1)
